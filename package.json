{
  "name": "poke-ter",
  "version": "2.0.0",
  "description": "Multiplayer Pokémon-inspired game with procedurally generated maps, built on real Pokémon Emerald data and art.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx apps/game-server/server.ts",
    "build": "vite build --outDir dist --emptyOutDir && esbuild apps/game-server/server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist-server/server.js",
    "start": "npm run build && node dist-server/server.js",
    "pipeline": "tsx tools/asset-pipeline/run-pipeline.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
