{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": "."
  },
  "include": [
    "server.ts",
    "server/**/*",
    "shared/**/*",
    "worldgen/**/*",
    "client/**/*",
    "assets-pipeline/**/*.ts",
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist", "dist-server", ".cache_pokeemerald"]
}
