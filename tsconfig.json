{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["packages/engine/*"],
      "@game-core/*": ["packages/game-core/*"],
      "@world/*": ["packages/world/*"],
      "@shared/*": ["packages/shared/*"],
      "@client/*": ["apps/game-client/*"],
      "@server/*": ["apps/game-server/*"]
    }
  },
  "include": [
    "apps/**/*",
    "packages/**/*",
    "tools/**/*"
  ],
  "exclude": ["node_modules", "dist", "dist-server", ".cache_pokeemerald"]
}
